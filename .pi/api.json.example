{
  "enabled": true,
  "url": "http://localhost:8080",
  "timeout_ms": 30000,
  "limits": {
    "max_response_bytes": 50000,
    "max_response_lines": 2000,
    "cursor_ttl_seconds": 3600
  },
  "auth": {
    "type": "login",
    "login_path": "/api/v1/auth/login",
    "identifier_field": "email",
    "accounts_file": ".pi/api.json.local",
    "account_alias": "ADMIN"
  },
  "swagger": {
    "enabled": true,
    "framework": "openapi"
  }
}
