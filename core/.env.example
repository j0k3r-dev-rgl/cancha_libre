# CanchaLibre Core Backend Configuration
PORT=8080
ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5435/canchalibre_dev?sslmode=disable
JWT_SECRET=super-secret-development-key-change-in-production

# Structured log level: debug, info, warn or error (default info).
# An unrecognized value stops the process instead of silently falling back.
LOG_LEVEL=info

# Private Prometheus scrape credential, at least 32 bytes when set.
# Unset (or empty) means /metrics does not exist at all: no route, no recording
# middleware, no per-request cost. The scraper sends it as
# `Authorization: Bearer <METRICS_TOKEN>`. See docs/design/metrics-endpoint.md.
# Put the real value in the gitignored core/.env, never in this template.
# METRICS_TOKEN=

# Go Runtime Constraints (2 vCPU / 150 MB VPS limits)
GOMAXPROCS=2
GOMEMLIMIT=150MiB
